# Portainer stack variables for vps-deployer (Stacks > vps-deployer > Environment variables).
# Not used as a file on the host: load it in Portainer via "Load variables from .env file" and fill in.
# Required: DEPLOYER_API_TOKEN, PUBLIC_IPV4, NPM_IDENTITY, NPM_SECRET, PORTAINER_API_KEY,
# PORTAINER_ENDPOINT_ID, TAILSCALE_IP. Empty optional values fall back to the defaults shown here.

# Bearer token Openclaw uses (generate: openssl rand -hex 32)
DEPLOYER_API_TOKEN=
# Tailscale address the API is bound to (never a public address)
TAILSCALE_IP=100.84.59.4
# Optional: pin a specific build, e.g. ghcr.io/tk-05/vps-deployer:<commit sha>
# DEPLOYER_IMAGE=ghcr.io/tk-05/vps-deployer:latest

BASE_DOMAIN=tk05.org
IMAGE_PREFIX=ghcr.io/tk-05/
# Extra names that must never be handed out (comma separated, replaces the default list)
# RESERVED_NAMES=www,mail,npm,...

# Optional. Empty = wildcard mode: *.tk05.org must already point to this VPS, the deployer only
# checks that the name resolves. Set a token (Zone.DNS:Edit, tk05.org only) to create records per app.
CF_API_TOKEN=
CF_ZONE_NAME=tk05.org
PUBLIC_IPV4=212.227.79.83
PUBLIC_IPV6=2a02:2479:a3:b900::1

# NPM user "deployer" (permissions: proxy hosts = manage, certificates = view, visibility = all)
NPM_URL=http://npm:81
NPM_HTTPS_HOST=npm
NPM_IDENTITY=
NPM_SECRET=

# Portainer API (replaces the Docker socket). Access token: Portainer > My account > Access tokens
# (user with access to the environment and to the ghcr.io registry, admin is simplest).
PORTAINER_URL=http://portainer:9000
PORTAINER_API_KEY=
# Environment id of the local Docker environment (Portainer URL shows it: #!/<id>/docker/...)
PORTAINER_ENDPOINT_ID=
# Id of the ghcr.io registry in Portainer > Registries (read:packages). 0 = pull without credentials.
PORTAINER_REGISTRY_ID=0
# false only for Portainer's self-signed certificate on https://portainer:9443
PORTAINER_VERIFY_TLS=true

APP_MEM_LIMIT=512m
APP_CPU_LIMIT=1.0
HEALTH_TIMEOUT=120
PENDING_TTL_HOURS=24
